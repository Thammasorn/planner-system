# Team Working OS — copy to .env (never commit .env). SPEC §10.3 + PLAN.md §3.12.
# Local development with `pnpm db:up` uses:
#   DATABASE_URL=postgres://planner:planner@localhost:54329/planner
DATABASE_URL=postgres://planner:CHANGE_ME@db:5432/planner
POSTGRES_PASSWORD=CHANGE_ME
# openssl rand -base64 32  (at least 32 characters)
BETTER_AUTH_SECRET=
# The URL users actually open
BETTER_AUTH_URL=https://planner.company.local
# false when served over plain HTTP on a LAN; switching it logs everyone out
SECURE_COOKIES=true
# Uploaded images/attachments (the Docker volume); local development uses UPLOAD_DIR=./uploads
UPLOAD_DIR=/data/uploads
# Upload limits in MB (images 1–100, attachments 1–200)
MAX_IMAGE_MB=10
MAX_ATTACHMENT_MB=25
TZ=Asia/Bangkok
INITIAL_MANAGER_EMAIL=
INITIAL_MANAGER_NAME=
# Used once; the manager must change it at first login
INITIAL_MANAGER_PASSWORD=
# Optional, comma-separated extra origins users open the app from (e.g. http://10.0.0.5:3000)
# TRUSTED_ORIGINS=
# Optional, comma-separated proxy IPs/CIDRs that append X-Forwarded-For (login lockout counts per IP + email)
# TRUSTED_PROXIES=
# DB_POOL_MAX=10
# Test-only — NEVER set in production (PLAN.md X45): ALLOW_TEST_HOOKS=1 enables APP_NOW and disables the auth rate limit
# ALLOW_TEST_HOOKS=1
# APP_NOW=2026-09-30T10:00:00+07:00
