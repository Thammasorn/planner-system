{
  "name": "team-working-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.23.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:up": "docker compose -f docker/docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker/docker-compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db-reset.ts",
    "bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap.ts",
    "seed:golden": "tsx --env-file-if-exists=.env scripts/seed-golden.ts",
    "import:holidays": "tsx --env-file-if-exists=.env scripts/import-holidays.ts",
    "auth:check": "auth check schema --config src/server/auth.ts"
  },
  "dependencies": {
    "@blocknote/core": "0.55.0",
    "@blocknote/mantine": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "9.4.0",
    "@mui/x-charts": "9.14.0",
    "@mui/x-date-pickers": "9.14.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-virtual": "3.14.13",
    "better-auth": "1.7.6",
    "cmdk": "1.1.1",
    "dayjs": "1.11.23",
    "drizzle-orm": "0.45.3",
    "file-type": "22.1.1",
    "fractional-indexing": "4.0.0",
    "next": "16.3.7",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@playwright/test": "~1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "~5.0.2",
    "auth": "1.7.6",
    "drizzle-kit": "0.31.11",
    "eslint": "~9.39.5",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "^8.3.1",
    "vitest": "~5.0.2"
  }
}
